{
  "name": "silvic",
  "version": "0.1.46",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @silvic/desktop dev",
    "build": "pnpm --filter @silvic/cli build && pnpm --filter @silvic/desktop build",
    "cli": "node apps/cli/dist/silvic.mjs",
    "package:mac": "pnpm --filter @silvic/desktop package:mac",
    "release:version": "node Scripts/set-release-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
