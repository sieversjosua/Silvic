{
  "name": "@silvic/desktop",
  "version": "0.1.8",
  "description": "Local-first control plane for parallel development environments",
  "repository": "https://github.com/sieversjosua/Silvic",
  "author": "Josua Sievers",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev --watch --config electron.vite.config.ts",
    "build": "electron-vite build --config electron.vite.config.ts && node ../../Scripts/verify-electron-bundle.mjs",
    "package:mac": "bash ../../Scripts/package-mac.sh"
  },
  "dependencies": {
    "@silvic/connector-convex": "workspace:*",
    "@silvic/connector-github": "workspace:*",
    "@silvic/connector-harnesses": "workspace:*",
    "@silvic/connector-local": "workspace:*",
    "@silvic/contracts": "workspace:*",
    "@silvic/core": "workspace:*",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "dev.silvic.app",
    "productName": "Silvic",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "../../Resources/Silvic-Electron.icns",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sieversjosua",
        "repo": "Silvic"
      }
    ]
  }
}
